# Copy this file to .env and fill in your keys. NEVER commit .env (it is in .gitignore).
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the model names (verify them on each provider's website; free models change).
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Docker (docker compose up) ---------------------------------------------------------
# Where you live: Baymax tells people to call this number in an emergency. Defaults are India's.
# BAYMAX_EMERGENCY_NUMBER=112
# BAYMAX_CRISIS_HELPLINE=            # empty = generic wording; for India: Tele-MANAS on 14416
# Use it from another device (needs https for the microphone):
# BAYMAX_BIND=0.0.0.0
# BAYMAX_TLS=1
# BAYMAX_TOKEN=pick-a-long-password
# BAYMAX_MEMORY=off                  # remember nothing
# BAYMAX_WHISPER_MODEL=base.en       # faster on slow CPUs
# BAYMAX_GGUF_URL=https://huggingface.co/<you>/<repo>/resolve/main/<file>.gguf
